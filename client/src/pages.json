      }
    },
    {
      "path": "pages/family/join",
      "style": {
        "navigationBarTitleText": "加入家庭"
      }
    },
    {
      "path": "pages/family/detail",
      "style": {
        "navigationBarTitleText": "家庭详情"
      }
    },
    {
      "path": "pages/family/members",
      "style": {
        "navigationBarTitleText": "家庭成员"
      }
    },
    {
      "path": "pages/dish/list",
