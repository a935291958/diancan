{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^u--(.*)": "uview-plus/components/u-$1/u-$1.vue",
      "^up-(.*)": "uview-plus/components/u-$1/u-$1.vue",
      "^u-([^-].*)": "uview-plus/components/u-$1/u-$1.vue",
      "^PageEmpty$": "@/components/PageEmpty/PageEmpty.vue",
      "^PageLoading$": "@/components/PageLoading/PageLoading.vue",
      "^DishCard$": "@/components/DishCard/DishCard.vue",
      "^FoodCard$": "@/components/FoodCard/FoodCard.vue",
      "^SpecEditor$": "@/components/SpecEditor/SpecEditor.vue",
      "^SpecPicker$": "@/components/SpecPicker/SpecPicker.vue",
      "^MemberList$": "@/components/MemberList/MemberList.vue",
      "^OrderList$": "@/components/OrderList/OrderList.vue"
    }
  },
  "pages": [
    {
      "path": "pages/index/index",
      "style": {
        "navigationBarTitleText": "家庭点餐",
        "enablePullDownRefresh": true
      }
    },
    {
