APP_NAME=MineAdmin
APP_ENV=dev
APP_DEBUG=true

# 对外访问地址（上传回显、伪静态反代后的域名）
APP_URL=http://127.0.0.1:9501

# 数据库：后台 MineAdmin 与小程序共用同一库；小程序逻辑表名 jt_jiating_*
# 若 DB_PREFIX=jt_，模型会去掉重复前缀。不要把 DB_PREFIX 设成 jt_jiating_
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mineadmin
DB_USERNAME=root
DB_PASSWORD=root
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_PREFIX=

REDIS_HOST=127.0.0.1
REDIS_AUTH=
REDIS_PORT=6379
REDIS_DB=0

JWT_SECRET=azOVxsOWt3r0ozZNz8Ss429ht0T8z6OpeIJAIwNp6X0xqrbEY2epfIWyxtC1qSNM8eD6/LQ/SahcQi2ByXa/2A==

MINE_ACCESS_TOKEN=(null) # Your MINE_ACCESS_TOKEN

# ---------- 小程序 / 跨域 ----------
MINI_TABLE_PREFIX=jt_jiating_
MINI_TOKEN_TTL=2592000
MINI_REPEAT_SUBMIT=true
MINI_REPEAT_SUBMIT_TTL=2

WECHAT_APPID=
WECHAT_SECRET=
# 本地联调设 true；生产必须 false 并填写上面两项
WECHAT_MOCK=true

CORS_ENABLE=true
CORS_ALLOW_ORIGIN=*
CORS_ALLOW_CREDENTIALS=true
